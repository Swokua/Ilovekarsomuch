                        if typed then
                            local Value = ENXUI:Rounding(math.clamp(typed, config.Min, config.Max), config.Round)
                            config.Default = Value
                            local normalized = (Value - config.Min) / (config.Max - config.Min)
                            TweenService:Create(block, TweenInfo.new(0.08), {
